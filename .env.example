# Copy to .env at the repository root (Appendix E). Never commit the real .env.
#
# Every variable here maps to a field on app.config.Settings, which reads this
# file by absolute path — so it applies whether you run from the repo root or
# from backend/. Settings uses extra="forbid": an unknown key here fails
# start-up rather than being silently ignored.

ENVIRONMENT=local
DEBUG=true

# --- database (must match docker-compose.yml) --------------------------------
# Port 55432, not 5432: the compose stack publishes on non-conventional ports so
# it cannot collide with a native PostgreSQL service. See docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://prashn:prashn@localhost:55432/prashn_setu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- third parties (Appendix E) ----------------------------------------------
# Leave blank for stubs. MSG91 must never send real SMS from a dev machine —
# the stub adapter writes OTPs to .dev/outbox/ instead. Wired at M2/M9/M10.
# MSG91_AUTH_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# LLM_MODE=cassette
